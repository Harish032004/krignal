    <style>
      .nav {
        position: sticky;
        top: 0;
        z-index: 1000;
        height: var(--nav-height);
        background: rgba(6, 6, 6, 0.88);
        border-bottom: 1px solid var(--line);
        backdrop-filter: blur(18px);
      }

      .nav-inner {
        height: 100%;
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        gap: 36px;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        font-size: 20px;
        font-weight: 700;
      }

      .brand-mark {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        background: var(--yellow);
        color: var(--black);
        font: 400 28px/1 var(--serif);
      }

      .nav-links {
        display: flex;
        justify-content: center;
        gap: 28px;
      }

      .nav-links a {
        position: relative;
        padding: 24px 0;
        color: #bbb9b1;
        font: 500 9px/1 var(--mono);
        letter-spacing: 0.11em;
        text-transform: uppercase;
      }

      .nav-links a::after {
        content: "";
        position: absolute;
        left: 0;
        right: 100%;
        bottom: 17px;
        height: 1px;
        background: var(--yellow);
        transition: right 0.25s ease;
      }

      .nav-links a:hover {
        color: var(--white);
      }

      .nav-links a:hover::after {
        right: 0;
      }

      .nav-cta {
        padding: 14px 18px;
        border-radius: 999px;
        background: var(--yellow);
        color: var(--black);
        font: 500 9px/1 var(--mono);
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .menu-btn {
        display: none;
        width: 44px;
        height: 44px;
        border: 1px solid var(--line);
        border-radius: 50%;
        background: transparent;
        cursor: pointer;
      }

      .menu-btn span {
        position: absolute;
        width: 17px;
        height: 1px;
        background: var(--white);
        transition: 0.25s ease;
      }

      .menu-btn span:first-child {
        transform: translateY(-4px);
      }

      .menu-btn span:last-child {
        transform: translateY(4px);
      }

      .menu-btn.open span:first-child {
        transform: rotate(45deg);
      }

      .menu-btn.open span:last-child {
        transform: rotate(-45deg);
      }

      .mobile-panel {
        position: fixed;
        inset: var(--nav-height) 0 auto;
        max-height: 0;
        overflow: hidden;
        background: var(--black);
        border-bottom: 1px solid var(--line);
        transition: max-height 0.35s ease;
      }

      .mobile-panel.open {
        max-height: calc(100vh - var(--nav-height));
      }

      .mobile-panel-inner {
        padding: 18px 24px 28px;
      }

      .mobile-panel a {
        display: block;
        padding: 17px 0;
        border-bottom: 1px solid var(--line);
        font: 500 11px/1 var(--mono);
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .mobile-panel .mobile-apply {
        margin-top: 18px;
        padding: 16px 18px;
        border: 0;
        border-radius: 999px;
        background: var(--yellow);
        color: var(--black);
        text-align: center;
      }

      @media (max-width: 1120px) {
        .nav-links,
        .nav-cta {
          display: none;
        }

        .nav-inner {
          grid-template-columns: auto 1fr auto;
        }

        .menu-btn {
          position: relative;
          display: grid;
          place-items: center;
          justify-self: end;
        }
      }

      @media (max-width: 700px) {
        .brand-mark {
          width: 38px;
          height: 38px;
          font-size: 25px;
        }
      }
    </style>

