    <style>
      :root {
        --black: #060606;
        --black-2: #101010;
        --black-3: #181818;
        --white: #f6f3ea;
        --paper: #ebe7dc;
        --yellow: #c89b3c;
        --yellow-soft: #e3c37a;
        --grey: #9d9a91;
        --line: rgba(246, 243, 234, 0.15);
        --dark-line: rgba(0, 0, 0, 0.17);
        --serif: "Libre Caslon Display", Georgia, serif;
        --sans: "DM Sans", system-ui, sans-serif;
        --mono: "IBM Plex Mono", monospace;
        --nav-height: 68px;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        background: var(--black);
        color: var(--white);
        font-family: var(--sans);
        overflow-x: hidden;
      }

      body.menu-open {
        overflow: hidden;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      button,
      input,
      textarea,
      select {
        font: inherit;
      }

      button {
        color: inherit;
      }

      img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      ::selection {
        background: var(--yellow);
        color: var(--black);
      }

      .container {
        width: min(1400px, calc(100% - 48px));
        margin-inline: auto;
      }

      .section {
        position: relative;
        padding: 120px 0;
      }

      .mono {
        font-family: var(--mono);
        font-size: 10px;
        line-height: 1.4;
        letter-spacing: 0.13em;
        text-transform: uppercase;
      }

      .yellow {
        color: var(--yellow);
      }

      .section-label {
        display: flex;
        align-items: center;
        gap: 14px;
        color: var(--yellow);
        margin-bottom: 26px;
      }

      .section-label::before {
        content: "";
        width: 44px;
        height: 1px;
        background: currentColor;
      }

      .section-title {
        font: 400 clamp(58px, 7.5vw, 112px) / 0.9 var(--serif);
        letter-spacing: -0.045em;
      }

      .section-copy {
        max-width: 660px;
        color: var(--grey);
        font-size: 18px;
        line-height: 1.7;
      }

      .reveal {
        opacity: 0;
        transform: translateY(38px);
        filter: blur(4px);
        transition:
          opacity 0.8s cubic-bezier(0.2, 0.7, 0.2, 1),
          transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1),
          filter 0.8s ease;
      }

      .reveal.in {
        opacity: 1;
        transform: none;
        filter: none;
      }

      .reveal[data-delay="1"] {
        transition-delay: 0.12s;
      }

      .reveal[data-delay="2"] {
        transition-delay: 0.24s;
      }

      .reveal[data-delay="3"] {
        transition-delay: 0.36s;
      }

      @media (max-width: 700px) {
        :root {
          --nav-height: 66px;
        }

        .container {
          width: min(100% - 30px, 1400px);
        }

        .section {
          padding: 84px 0;
        }

        .section-title {
          font-size: 56px;
        }

        .section-copy {
          font-size: 16px;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation: none !important;
          transition: none !important;
          scroll-behavior: auto !important;
        }

        .reveal {
          opacity: 1;
          transform: none;
          filter: none;
        }
      }
    </style>
