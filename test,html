  /* =========================================================
     HERO WRAPPER
  ========================================================== */

  .hero-stack {
    position: relative;
    height: 185vh;

    background:
      radial-gradient(
        circle at 62% 45%,
        rgba(0, 0, 0, 0.065),
        transparent 34%
      ),
      #f4f2ed;
  }

  .hero-sticky {
    position: sticky;
    top: var(--nav-height, 76px);

    width: 100%;
    height: calc(100vh - var(--nav-height, 76px));
    min-height: 620px;

    overflow: hidden;
    isolation: isolate;

    background: #f4f2ed;
  }

  .hero-sticky::before {
    content: "";

    position: absolute;
    inset: 0;
    z-index: 0;

    pointer-events: none;

    background-image:
      linear-gradient(
        rgba(0, 0, 0, 0.032) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(0, 0, 0, 0.032) 1px,
        transparent 1px
      );

    background-size: 54px 54px;
  }

  .hero-sticky::after {
    content: "";

    position: absolute;
    inset: 0;
    z-index: 0;

    pointer-events: none;

    background:
      linear-gradient(
        90deg,
        rgba(244, 242, 237, 0.26),
        transparent 38%,
        transparent 100%
      );
  }


