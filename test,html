    letter-spacing: -0.03em;
  }

  .hero-mini-card p {
    margin: 7px 0 0;

    color: #c5c0b5;

    font:
      400 clamp(11px, 0.77vw, 13px) / 1.46
      var(--sans, "DM Sans", sans-serif);
  }


  /* =========================================================
     MEMBERSHIP APPLICATION BOX
  ========================================================== */

  .hero-membership-referral {
    width: fit-content;
    max-width: 100%;
    min-height: 45px;

    display: inline-flex;
    align-items: center;
    justify-content: space-between;

    gap: 24px;

    margin-top: 15px;
    padding: 0 18px;

    border: 1px dashed rgba(237, 199, 90, 0.68);
    border-radius: 6px;

    background: rgba(237, 199, 90, 0.025);
    color: #edc75a;

    font-family:
      "IBM Plex Mono",
      monospace;

    font-size: clamp(7px, 0.7vw, 10px);
    font-weight: 500;
    line-height: 1.3;

    letter-spacing: 0.17em;
    text-transform: uppercase;

