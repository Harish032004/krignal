    <script>
      window.__KRIGNAL_HERO_MODE__ = "smooth-lite";
    </script>
    <script>
      (() => {
        "use strict";

        const clamp = (value, min = 0, max = 1) =>
          Math.min(max, Math.max(min, value));

        const smoothStep = (start, end, value) => {
          const t = clamp((value - start) / (end - start));
          return t * t * (3 - 2 * t);
        };

        /* Reveal animation */
        const revealElements = document.querySelectorAll(".reveal");
        if ("IntersectionObserver" in window) {
          const revealObserver = new IntersectionObserver(
            (entries, observer) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                entry.target.classList.add("in");
                observer.unobserve(entry.target);
              });
            },
            { threshold: 0.12, rootMargin: "0px 0px -50px" },
          );

          revealElements.forEach((element) => revealObserver.observe(element));
        } else {
          revealElements.forEach((element) => element.classList.add("in"));
        }

        /* Mobile menu */
        const menuButton = document.querySelector(".menu-btn");
        const mobilePanel = document.querySelector(".mobile-panel");

        const closeMenu = () => {
          menuButton.classList.remove("open");
          menuButton.setAttribute("aria-expanded", "false");
          mobilePanel.classList.remove("open");
          mobilePanel.setAttribute("aria-hidden", "true");
          document.body.classList.remove("menu-open");
        };

        menuButton.addEventListener("click", () => {
          const isOpen = menuButton.classList.toggle("open");
          menuButton.setAttribute("aria-expanded", String(isOpen));
          mobilePanel.classList.toggle("open", isOpen);
          mobilePanel.setAttribute("aria-hidden", String(!isOpen));
          document.body.classList.toggle("menu-open", isOpen);
        });

        mobilePanel.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", closeMenu);
        });

        /* Hero stack: one-by-one rise, tidy stack, then aligned scroll mosaic */
        if (window.__KRIGNAL_HERO_MODE__ === "smooth-lite") {
          return;
        }
        const heroSection = document.querySelector(".hero-stack");
        const heroSticky = document.getElementById("heroSticky");
        const heroGallery = document.getElementById("heroGallery");
        const heroFinal = document.getElementById("heroFinal");
        const heroCards = [...document.querySelectorAll(".hero-card")];
        const heroProgressBar = document.getElementById("heroProgressBar");
        const heroScrollNote = document.getElementById("heroScrollNote");
        const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        let heroIntroComplete = reducedMotion;
        let heroFrameRequested = false;

        const desktopTargets = [
          { x: 62.7, y: 16, rotation: -4, scale: 1, z: 4 },
          { x: 73.2, y: 16, rotation: -1, scale: 1, z: 5 },
          { x: 83.7, y: 16, rotation: 1, scale: 1, z: 6 },
          { x: 94.2, y: 16, rotation: 4, scale: 1, z: 7 },
          { x: 62.7, y: 35.2, rotation: -3, scale: 1, z: 8 },
          { x: 73.2, y: 35.2, rotation: -1, scale: 1, z: 9 },
          { x: 83.7, y: 35.2, rotation: 1, scale: 1, z: 10 },
          { x: 94.2, y: 35.2, rotation: 3, scale: 1, z: 11 },
          { x: 62.7, y: 54.4, rotation: -4, scale: 1, z: 12 },
          { x: 73.2, y: 54.4, rotation: -1, scale: 1, z: 13 },
          { x: 83.7, y: 54.4, rotation: 1, scale: 1, z: 14 },
          { x: 94.2, y: 54.4, rotation: 4, scale: 1, z: 15 },
          { x: 62.7, y: 73.6, rotation: -3, scale: 1, z: 16 },
          { x: 73.2, y: 73.6, rotation: -1, scale: 1, z: 17 },
          { x: 83.7, y: 73.6, rotation: 1, scale: 1, z: 18 },
          { x: 94.2, y: 73.6, rotation: 3, scale: 1.1, z: 19 }
        ];

        const mobileTargets = [
          { x: 18, y: 68, rotation: -4, z: 4 },
          { x: 50, y: 68, rotation: 0, z: 5 },
          { x: 82, y: 68, rotation: 4, z: 6 },
          { x: 18, y: 81, rotation: -3, z: 7 },
          { x: 50, y: 81, rotation: 0, z: 8 },
          { x: 82, y: 81, rotation: 3, z: 9 },
          { x: 18, y: 94, rotation: -4, z: 10 },
          { x: 50, y: 94, rotation: 0, z: 11 },
          { x: 82, y: 94, rotation: 4, z: 12 }
        ];

        const stackState = (index, isMobile) => {
          return {
            x: 50,
            y: isMobile ? 43 : 50,
            rotation: ((index % 5) - 2) * (isMobile ? 0.45 : 0.5),
            scale: (isMobile ? 0.9 : 0.94) - index * 0.0025,
          };
        };

        const setCardPosition = (card, index, spread) => {
          const isMobile = window.innerWidth <= 760;
          if (isMobile && index >= mobileTargets.length) {
            card.style.opacity = "0";
            card.style.pointerEvents = "none";
            return;
          }
          const target = isMobile
            ? { ...desktopTargets[index], ...mobileTargets[index], scale: 0.67 }
            : desktopTargets[index];
          const stack = stackState(index, isMobile);
          const x = stack.x + (target.x - stack.x) * spread;
          const y = stack.y + (target.y - stack.y) * spread;
          const rotation = stack.rotation + (target.rotation - stack.rotation) * spread;
          const scale = stack.scale + (target.scale - stack.scale) * spread;

          card.style.left = `${x}%`;
          card.style.top = `${y}%`;
          card.style.zIndex = String(spread < 0.18 ? index + 1 : target.z);
          card.style.transform = `translate(-50%, -50%) rotate(${rotation}deg) scale(${scale})`;
          card.style.opacity = "1";
        };

        const updateHero = () => {
          heroFrameRequested = false;
          const navHeight = parseFloat(getComputedStyle(document.documentElement).getPropertyValue("--nav-height"));
          const sectionTop = heroSection.offsetTop - navHeight;
          const travel = Math.max(1, heroSection.offsetHeight - heroSticky.offsetHeight);
          const progress = clamp((window.scrollY - sectionTop) / travel);
          const spreadProgress = heroIntroComplete
            ? Math.min(0.58 + progress * 0.42, 1)
            : progress;
          const panelProgress = heroIntroComplete
            ? Math.min(0.9 + progress * 0.1, 1)
            : progress;
          const spread = smoothStep(0.035, 0.61, spreadProgress);
          const panel = smoothStep(0.52, 0.9, panelProgress);

          if (heroIntroComplete || progress > 0.012) {
            heroCards.forEach((card, index) => setCardPosition(card, index, spread));
          }

          if (window.innerWidth <= 760) {
            heroFinal.style.clipPath = `inset(${100 - panel * 100}% 0 0 0 round 22px)`;
            heroFinal.style.transform = `translateY(${(1 - panel) * 24}px)`;
          } else {
            heroFinal.style.clipPath = `inset(0 0 0 ${100 - panel * 100}% round 28px)`;
            heroFinal.style.transform = `translateX(${(1 - panel) * 28}px)`;
          }

          heroFinal.style.opacity = String(panel);
          heroGallery.style.transform = `scale(${1 - panel * 0.012})`;
          if (heroProgressBar) {
            heroProgressBar.style.width = `${progress * 100}%`;
          }
          if (heroScrollNote) {
            heroScrollNote.style.opacity = String(clamp(1 - progress * 4));
          }
        };

        const requestHeroUpdate = () => {
          if (heroFrameRequested) return;
          heroFrameRequested = true;
          requestAnimationFrame(updateHero);
        };

        const playHeroIntro = async () => {
          if (reducedMotion || window.scrollY > heroSection.offsetTop + 30) {
            heroIntroComplete = true;
            updateHero();
            return;
          }

          const isMobile = window.innerWidth <= 760;
          heroCards.forEach((card, index) => {
            const stack = stackState(index, isMobile);
            card.style.left = `${stack.x}%`;
            card.style.top = `${stack.y}%`;
            card.style.zIndex = String(index + 1);
            card.style.opacity = "1";

            card.animate(
              [
                {
                  transform: `translate(-50%, calc(-50% + 112vh)) rotate(${stack.rotation - 9}deg) scale(0.72)`,
                  opacity: 0,
                },
                {
                  offset: 0.82,
                  transform: `translate(-50%, calc(-50% - 9px)) rotate(${stack.rotation + 0.5}deg) scale(${stack.scale + 0.012})`,
                  opacity: 1,
                },
                {
                  transform: `translate(-50%, -50%) rotate(${stack.rotation}deg) scale(${stack.scale})`,
                  opacity: 1,
                },
              ],
              {
                duration: 800,
                delay: index * 145,
                easing: "cubic-bezier(.18,.78,.22,1)",
                fill: "forwards",
              },
            );
          });

          await new Promise((resolve) =>
            setTimeout(resolve, 800 + (heroCards.length - 1) * 145 + 120),
          );

          heroIntroComplete = true;
          updateHero();
        };

        window.addEventListener("scroll", requestHeroUpdate, { passive: true });
        window.addEventListener("resize", requestHeroUpdate);
        playHeroIntro();
        updateHero();

        /* Section 4: tabbed seamless infinite image carousels */
        const tvConsole = document.getElementById("tvConsole");
        const tvButtons = [...document.querySelectorAll(".tv-index button")];
        const tvPanels = [...document.querySelectorAll(".tv-panel")];
        let tvTimer = null;

        if (!(tvConsole && tvConsole.dataset.tvEnhanced === "true")) {

        const updateTvDots = (panel, logicalIndex) => {
          panel.querySelectorAll(".tv-dot").forEach((dot, index) => {
            dot.classList.toggle("active", index === logicalIndex);
          });
        };

        const setTvTrack = (panel, trackIndex, animate = true) => {
          const track = panel.querySelector(".tv-slides");
          if (!animate) track.classList.add("no-transition");
          panel.dataset.trackIndex = String(trackIndex);
          panel.dataset.animating = animate ? "true" : "false";
          track.style.transform = `translate3d(-${trackIndex * 100}%, 0, 0)`;
          if (!animate) {
            requestAnimationFrame(() => requestAnimationFrame(() => {
              track.classList.remove("no-transition");
              panel.dataset.animating = "false";
            }));
          }
        };

        const initialiseTvPanel = (panel) => {
          const track = panel.querySelector(".tv-slides");
          const originals = [...track.children];
          const count = originals.length;
          if (!count) return;

          panel.dataset.slideCount = String(count);
          const firstClone = originals[0].cloneNode(true);
          const lastClone = originals[count - 1].cloneNode(true);
          firstClone.classList.add("tv-clone");
          lastClone.classList.add("tv-clone");
          firstClone.setAttribute("aria-hidden", "true");
          lastClone.setAttribute("aria-hidden", "true");
          track.prepend(lastClone);
          track.append(firstClone);
          panel.dataset.index = "0";
          panel.dataset.animating = "false";
          setTvTrack(panel, 1, false);

          const dotContainer = panel.querySelector(".tv-dots");
          dotContainer.innerHTML = "";
          originals.forEach((_, index) => {
            const dot = document.createElement("button");
            dot.type = "button";
            dot.className = `tv-dot${index === 0 ? " active" : ""}`;
            dot.setAttribute("aria-label", `Go to image ${index + 1}`);
            dot.addEventListener("click", () => {
              panel.dataset.index = String(index);
              updateTvDots(panel, index);
              setTvTrack(panel, index + 1, true);
              restartTvAutoplay();
            });
            dotContainer.appendChild(dot);
          });

          track.addEventListener("transitionend", (event) => {
            if (event.propertyName !== "transform") return;
            const currentTrackIndex = Number(panel.dataset.trackIndex || 1);
            if (currentTrackIndex === 0) {
              setTvTrack(panel, count, false);
            } else if (currentTrackIndex === count + 1) {
              setTvTrack(panel, 1, false);
            } else {
              panel.dataset.animating = "false";
            }
          });
        };

        const activeTvPanel = () => document.querySelector(".tv-panel.active");

        const moveTvSlide = (panel, direction) => {
          if (!panel || panel.dataset.animating === "true") return;
          const count = Number(panel.dataset.slideCount || 0);
          if (!count) return;
          let currentTrackIndex = Number(panel.dataset.trackIndex || 1);
          if (currentTrackIndex < 0 || currentTrackIndex > count + 1) {
            currentTrackIndex = 1;
            setTvTrack(panel, 1, false);
          }
          const nextTrackIndex = currentTrackIndex + direction;
          const logicalIndex = (nextTrackIndex - 1 + count) % count;
          panel.dataset.index = String(logicalIndex);
          updateTvDots(panel, logicalIndex);
          setTvTrack(panel, nextTrackIndex, true);
        };

        const changeTvSlide = (direction) => moveTvSlide(activeTvPanel(), direction);

        const restartTvAutoplay = () => {
          window.clearInterval(tvTimer);
          tvTimer = window.setInterval(() => changeTvSlide(1), 3000);
        };

        document.querySelectorAll(".tv-slide img").forEach((image) => {
          const markMissing = () => image.classList.add("is-missing");
          image.addEventListener("error", markMissing, { once: true });
          if (image.complete && image.naturalWidth === 0) markMissing();
          const preload = new Image();
          preload.onerror = markMissing;
          preload.src = image.currentSrc || image.src;
        });

        tvPanels.forEach((panel) => {
          initialiseTvPanel(panel);
          panel.querySelector(".tv-prev").addEventListener("click", () => {
            moveTvSlide(panel, -1);
            restartTvAutoplay();
          });
          panel.querySelector(".tv-next").addEventListener("click", () => {
            moveTvSlide(panel, 1);
            restartTvAutoplay();
          });
        });

        const activateTvPanel = (panelId) => {
          const nextPanel = tvPanels.find((panel) => panel.id === panelId);
          if (!nextPanel) return;

          tvButtons.forEach((item) => {
            const isActive = item.dataset.tv === panelId;
            item.classList.toggle("active", isActive);
            item.setAttribute("aria-selected", String(isActive));
          });

          tvPanels.forEach((panel) => {
            const isActive = panel.id === panelId;
            panel.classList.toggle("active", isActive);
            panel.setAttribute("aria-hidden", String(!isActive));
            panel.style.opacity = isActive ? "1" : "0";
            panel.style.visibility = isActive ? "visible" : "hidden";
            panel.style.pointerEvents = isActive ? "auto" : "none";
            panel.style.zIndex = isActive ? "2" : "1";
          });
        };

        tvButtons.forEach((button) => {
          button.addEventListener("click", () => {
            activateTvPanel(button.dataset.tv);
            restartTvAutoplay();
          });
        });

        activateTvPanel("brand");

        tvConsole.addEventListener("mouseenter", () => window.clearInterval(tvTimer));
        tvConsole.addEventListener("mouseleave", restartTvAutoplay);
        restartTvAutoplay();
        }

        /* Section 5 event tabs */
        if (!(document.getElementById("events")?.dataset.eventsEnhanced === "true")) {
          document.querySelectorAll(".event-switch button").forEach((button) => {
            button.addEventListener("click", () => {
              document
                .querySelectorAll(".event-switch button")
                .forEach((item) => item.classList.remove("active"));
              document
                .querySelectorAll(".event-panel")
                .forEach((panel) => panel.classList.remove("active"));

              button.classList.add("active");
              document.getElementById(button.dataset.event).classList.add("active");
            });
          });
        }

        /* FAQ accordion */
        if (!(document.getElementById("faq")?.dataset.faqEnhanced === "true")) {
          document.querySelectorAll(".faq-question").forEach((button) => {
            button.addEventListener("click", () => {
              const item = button.closest(".faq-item");
              const wasOpen = item.classList.contains("open");

              document.querySelectorAll(".faq-item").forEach((faqItem) => {
                faqItem.classList.remove("open");
                faqItem
                  .querySelector(".faq-question")
                  .setAttribute("aria-expanded", "false");
              });

              if (!wasOpen) {
                item.classList.add("open");
                button.setAttribute("aria-expanded", "true");
              }
            });
          });
        }
      })();
    </script>

