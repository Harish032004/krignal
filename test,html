      background 0.3s ease,
      transform 0.3s ease;
  }

  .hero-membership-referral:hover {
    border-color: #edc75a;
    background: rgba(237, 199, 90, 0.1);
    transform: translateY(-2px);
  }

  .hero-membership-referral i {
    flex: 0 0 auto;

    color: #edc75a;

    font-size: 13px;
    font-style: normal;

    transition: transform 0.3s ease;
  }

  .hero-membership-referral:hover i {
    transform: translate(4px, -4px);
  }


  /* =========================================================
     HERO ACTION BUTTONS
  ========================================================== */

  .hero-actions {
    position: relative;
    z-index: 5;

    display: flex;
    align-items: center;
    flex-wrap: wrap;

    gap: 12px;

    margin-top: 14px;
  }

  .hero-btn {
    min-height: 56px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    gap: 13px;

    padding: 17px 28px;

    border: 1px solid #edc75a;
    border-radius: 999px;

    background: #edc75a;
    color: #090909;

    box-shadow:
      0 10px 32px
      rgba(237, 199, 90, 0.18);

    font:
      500 10px/1
      var(--mono, "IBM Plex Mono", monospace);

    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;

    transition:
      background 0.3s ease,
      color 0.3s ease,
      transform 0.3s ease;
  }

  .hero-btn:hover {
    background: transparent;
    color: #edc75a;
    transform: translateY(-2px);
  }

  .hero-text-link {
    min-height: 40px;

    display: inline-flex;
    align-items: center;

    gap: 10px;
    padding: 0 4px;

    color: #bbb6ac;

    font:
      500 7px/1
      var(--mono, "IBM Plex Mono", monospace);

    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hero-text-link span {
    color: #edc75a;
    transition: transform 0.3s ease;
  }

  .hero-text-link:hover span {
    transform: translateX(4px);
  }


  /* =========================================================
     SCROLL NOTE AND PROGRESS
  ========================================================== */

  .hero-scroll-note {
    position: absolute;

    left: 15px;
    bottom: 25px;

    z-index: 60;

    color: rgba(0, 0, 0, 0.53);

    writing-mode: vertical-rl;
    transform: rotate(180deg);

    font:
      500 7px/1
      var(--mono, "IBM Plex Mono", monospace);

    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .hero-progress {
    position: absolute;

    left: 0;
    right: 0;
    bottom: 0;

    z-index: 70;

    height: 4px;

    background: rgba(0, 0, 0, 0.08);
  }

  .hero-progress span {
    display: block;

    width: 0;
    height: 100%;

    background: #edc75a;

    will-change: width;
  }


