  let rawProgress=0;
  let smoothProgress=0;
  let mx=0,my=0,tx=0,ty=0;
  let ticking=true;

  /* Scroll phases: fan animation first, content reveal last. */
  const FAN_END=.80;
  const PANEL_START=.775;

  function getProgress(){
    const sectionTop = section.getBoundingClientRect().top + window.scrollY;
    const stickyTop = parseFloat(getComputedStyle(sticky).top) || 0;
    const start = sectionTop - stickyTop;
    const end = start + Math.max(1, section.offsetHeight - sticky.offsetHeight);
    return clamp((window.scrollY - start) / Math.max(1,end-start),0,1);
  }

  function renderCards(p){
    const w=sticky.clientWidth;
    const h=sticky.clientHeight;
    const mobile=w<=760;
    const tablet=w>760 && w<=1100;

    const fanP=clamp(p/FAN_END,0,1);

    /* 0 -> last card: every wheel scroll visibly advances the fan. */
    const active=fanP*(cards.length-1);

    /* Before first card settles, fan rises from below for a clear opening motion. */
    const intro=clamp(fanP/.10,0,1);
    const introEase=ease(intro);

    const spacing=mobile ? Math.min(w*.40,148)
                 : tablet ? Math.min(w*.23,205)
                 : Math.min(w*.142,245);

    const visible=mobile?2.65:tablet?4.25:6.3;
    const baseY=mobile ? h*.035 : -h*.105;
    const arcY=mobile?34:tablet?38:42;
    const rot=mobile?9.0:tablet?9.8:10.6;

    const panelRaw=clamp((p-PANEL_START)/(1-PANEL_START),0,1);
    const panel=ease(panelRaw);

    cards.forEach((card,i)=>{
      const d=i-active;
      const ad=Math.abs(d);
      const limited=Math.min(ad,visible);

      let x=d*spacing;
      let y=baseY + Math.pow(limited,1.38)*arcY;

      /* Opening rise: whole deck starts below viewport and settles into the fan. */
      y += (1-introEase)*h*.62;

      /* Small mouse parallax. */
      x += mx*(10+Math.min(ad,3)*3);
      y += my*7;

      /* Shift fan aside while final content is revealed. */
      x += panel*w*(mobile?.10:.255);
      y += panel*h*(mobile?.035:.018);

      const angle=d*rot;
      const scale=clamp(1.22-ad*(mobile?.13:.09),mobile?.69:.64,1.22);
      const z=-Math.min(ad,visible)*40;

      let opacity=ad>visible ? 0 : clamp(1.06-ad*(mobile?.25:.14),.08,1);
      opacity*=clamp(introEase*1.22,0,1);
      opacity*=1-panel*(mobile?.82:.58);

      card.style.opacity=opacity.toFixed(3);
      card.style.zIndex=String(300-Math.round(ad*20));
      card.style.transform=
        `translate3d(calc(-50% + ${x.toFixed(2)}px),calc(-50% + ${y.toFixed(2)}px),${z.toFixed(1)}px) `+
        `rotate(${angle.toFixed(2)}deg) scale(${scale.toFixed(3)})`;

      card.classList.toggle('is-active',Math.abs(d)<.5);

      const img=card.querySelector('img');
      if(img){
        const blur=clamp((ad-1.15)*.65,0,3.1);
        const bright=clamp(1-ad*.055,.66,1);
        img.style.setProperty('filter',`grayscale(1) contrast(1.03) brightness(${bright.toFixed(2)}) blur(${blur.toFixed(2)}px)`,'important');
      }
    });

    if(finalPanel){
      finalPanel.classList.toggle('is-final-visible',panelRaw>.005);
      finalPanel.style.opacity=panel.toFixed(3);
      finalPanel.style.transform=`translate3d(${(-70*(1-panel)).toFixed(2)}px,0,0)`;
      finalPanel.style.clipPath=`inset(0 ${(100*(1-panel)).toFixed(2)}% 0 0 round 28px)`;
    }

    if(progressBar) progressBar.style.transform=`scaleX(${p.toFixed(4)})`;
    if(scrollNote) scrollNote.style.opacity=String(1-clamp(p/.12,0,1));
  }

  function frame(){
    rawProgress=getProgress();
    smoothProgress=lerp(smoothProgress,rawProgress,.14);
    mx=lerp(mx,tx,.09);
    my=lerp(my,ty,.09);

    /* Snap when almost equal so the loop remains stable. */
    if(Math.abs(rawProgress-smoothProgress)<.00005) smoothProgress=rawProgress;

    renderCards(smoothProgress);
    requestAnimationFrame(frame);
  }

  /* Pointer parallax is optional; scroll is the real driver. */
  sticky.addEventListener('pointermove',e=>{
    const r=sticky.getBoundingClientRect();
    tx=clamp(((e.clientX-r.left)/r.width-.5)*2,-1,1);
    ty=clamp(((e.clientY-r.top)/r.height-.5)*2,-1,1);
  },{passive:true});
  sticky.addEventListener('pointerleave',()=>{tx=0;ty=0;},{passive:true});

  /* Force recalculation after layout/images/fonts settle. */
  window.addEventListener('load',()=>{rawProgress=getProgress();smoothProgress=rawProgress;renderCards(smoothProgress);},{once:true});
  window.addEventListener('resize',()=>{rawProgress=getProgress();},{passive:true});

  rawProgress=getProgress();
  smoothProgress=rawProgress;
  renderCards(smoothProgress);
  requestAnimationFrame(frame);
})();
</script>


