<script>
(() => {
  if (window.__KRIGNAL_HERO_MODE__ === "smooth-lite") return;
  const section = document.querySelector('.hero-stack');
  const sticky = document.querySelector('.hero-sticky');
  const cards = [...document.querySelectorAll('.hero-card')];
  const stages = {
    brand: document.querySelector('[data-stage="brand"]'),
    tv: document.querySelector('[data-stage="tv"]'),
    offline: document.querySelector('[data-stage="offline"]'),
    ai: document.querySelector('[data-stage="ai"]')
  };
  const progressBar = document.getElementById('heroProgressBar');

  if (!section || !sticky || !cards.length) return;

  const clamp = (v, min = 0, max = 1) => Math.min(max, Math.max(min, v));
  const smooth = t => {
    t = clamp(t);
    return t * t * (3 - 2 * t);
  };

  let ticking = false;

  function getProgress() {
    const rect = section.getBoundingClientRect();
    const stickyTop = parseFloat(getComputedStyle(sticky).top) || 0;
    const sectionTop = window.scrollY + rect.top;
    const start = sectionTop - stickyTop;
    const travel = Math.max(1, section.offsetHeight - sticky.offsetHeight);
    return clamp((window.scrollY - start) / travel);
  }

  function range(p, start, end) {
    return clamp((p - start) / (end - start));
  }

  function sceneOpacity(p, start, fadeInEnd, fadeOutStart, end) {
    const enter = smooth(range(p, start, fadeInEnd));
    const leave = 1 - smooth(range(p, fadeOutStart, end));
    return clamp(Math.min(enter, leave));
  }

  function paintStage(el, opacity) {
    if (!el) return;
    el.style.opacity = opacity.toFixed(4);
    el.style.visibility = opacity > .01 ? 'visible' : 'hidden';
    el.style.transform = `translate3d(-50%, ${((1 - opacity) * 10).toFixed(2)}px, 0)`;
  }

  function paintFixedArc(p) {
    const vw = window.innerWidth;
    const vh = sticky.clientHeight;
    const mobile = vw <= 760;
    const visibleCards = mobile ? Math.min(cards.length, 10) : cards.length;

    /* Only this entrance portion moves. */
    const entrance = smooth(range(p, 0.00, 0.105));
    const centre = (visibleCards - 1) / 2;
    const stepX = mobile ? vw * .245 : Math.min(vw * .092, 150);
    const maxDistance = Math.max(1, centre);
    const baseY = mobile ? vh * .055 : vh * .045;

    cards.forEach((card, i) => {
      if (i >= visibleCards) {
        card.style.opacity = '0';
        card.style.visibility = 'hidden';
        return;
      }

      const rel = i - centre;
      const distance = Math.abs(rel);
      const side = clamp(distance / maxDistance);

      /* Final arc coordinates NEVER change after entrance. */
      const finalX = rel * stepX;
      const finalY = baseY + Math.pow(distance, 1.42) * (mobile ? 12 : 15.5);
      const finalRotate = rel * (mobile ? 7.3 : 5.8);
      const finalScale = 1.10 - side * (mobile ? .24 : .32);

      /* Entrance starts below the viewport and converges into the same fixed arc. */
      const startX = finalX * .42;
      const startY = vh * .86 + distance * 8;
      const startRotate = finalRotate * 1.8;
      const startScale = .76;

      const x = startX + (finalX - startX) * entrance;
      const y = startY + (finalY - startY) * entrance;
      const rotate = startRotate + (finalRotate - startRotate) * entrance;
      const scale = startScale + (finalScale - startScale) * entrance;
      const opacity = entrance * (1 - side * .08);

      card.style.visibility = 'visible';
      card.style.zIndex = String(100 - Math.round(distance * 8));
      card.style.opacity = opacity.toFixed(4);
      card.style.filter = 'none';
      card.style.transform = `translate3d(calc(-50% + ${x.toFixed(2)}px), ${y.toFixed(2)}px, 0) rotate(${rotate.toFixed(2)}deg) scale(${scale.toFixed(4)})`;
    });
  }

  function update() {
    ticking = false;
    const p = getProgress();

    paintFixedArc(p);

    /* After entrance, ONLY the text changes. The image arc is frozen. */
    paintStage(stages.brand,   sceneOpacity(p, .095, .125, .275, .315));
    paintStage(stages.tv,      sceneOpacity(p, .295, .335, .465, .505));
    paintStage(stages.offline, sceneOpacity(p, .485, .525, .655, .695));

    /* AI remains visible until the hero ends. */
    const aiIn = smooth(range(p, .675, .725));
    paintStage(stages.ai, aiIn);

    if (progressBar) {
      progressBar.style.width = `${(p * 100).toFixed(2)}%`;
    }
  }

  function requestPaint() {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(update);
    }
  }

  window.addEventListener('scroll', requestPaint, { passive: true });
  window.addEventListener('resize', requestPaint, { passive: true });

  update();
})();
</script>


