      <script>
        (() => {
          const tvConsoleInline = document.getElementById("tvConsole");
          if (!tvConsoleInline) return;
          tvConsoleInline.dataset.tvEnhanced = "true";

          const tvTabsInline = [
            ...tvConsoleInline.querySelectorAll(".tv-index > button[data-tv]"),
          ];
          const tvPanelsInline = [
            ...tvConsoleInline.querySelectorAll(".tv-stage > .tv-panel"),
          ];
          const tvPanelState = new Map();
          let tvTimerInline = null;

          const pauseVideosInPanel = (panel) => {
            panel.querySelectorAll("video").forEach((video) => video.pause());
          };

          const pauseAllVideos = () => {
            tvPanelsInline.forEach((panel) => pauseVideosInPanel(panel));
          };

          const getLogicalIndex = (panel) => {
            const state = tvPanelState.get(panel);
            if (!state) return 0;
            return (state.trackIndex - 1 + state.count) % state.count;
          };

          const updateDotsInline = (panel, index) => {
            panel.querySelectorAll(".tv-dot").forEach((dot, dotIndex) => {
              dot.classList.toggle("active", dotIndex === index);
            });
          };

          const updateMediaToggleInline = (panel) => {
            const toggle = panel.querySelector(".tv-media-toggle");
            const state = tvPanelState.get(panel);
            if (!toggle || !state) return;
            const video = state.originalSlides[getLogicalIndex(panel)]?.querySelector("video");
            if (!video) {
              toggle.hidden = true;
              toggle.classList.remove("is-playing");
              return;
            }

            toggle.hidden = false;
            toggle.setAttribute(
              "aria-label",
              video.paused ? "Play video" : "Pause video",
            );
            toggle.classList.toggle("is-playing", !video.paused);
          };

          const renderPanelInline = (panel, animate = true) => {
            const state = tvPanelState.get(panel);
            if (!state) return;
            if (!animate) {
              state.track.classList.add("no-transition");
            }
            state.track.style.transform = `translate3d(-${state.trackIndex * 100}%, 0, 0)`;
            panel.dataset.index = String(getLogicalIndex(panel));
            updateDotsInline(panel, getLogicalIndex(panel));
            updateMediaToggleInline(panel);
            if (!animate) {
              requestAnimationFrame(() => requestAnimationFrame(() => {
                state.track.classList.remove("no-transition");
              }));
            }
          };

          const changeSlideInline = (panel, direction) => {
            const state = tvPanelState.get(panel);
            if (!state || state.animating) return;
            pauseVideosInPanel(panel);
            state.animating = true;
            state.trackIndex += direction;
            renderPanelInline(panel);
          };

          const activePanelInline = () =>
            tvPanelsInline.find((panel) => panel.classList.contains("active")) || tvPanelsInline[0];

          const getActivePanelVideo = (panel = activePanelInline()) => {
            const state = panel ? tvPanelState.get(panel) : null;
            return state?.originalSlides[getLogicalIndex(panel)]?.querySelector("video") || null;
          };

          const isActiveVideoPlaying = () => {
            const video = getActivePanelVideo();
            return !!(video && !video.paused && !video.ended);
          };

          const restartAutoplayInline = () => {
            window.clearInterval(tvTimerInline);
            if (isActiveVideoPlaying()) return;
            tvTimerInline = window.setInterval(() => {
              const panel = activePanelInline();
              if (!panel) return;
              if (isActiveVideoPlaying()) return;
              changeSlideInline(panel, 1);
            }, 3000);
          };

          tvPanelsInline.forEach((panel) => {
            const track = panel.querySelector(".tv-slides");
            const originalSlides = [...panel.querySelectorAll(".tv-slide")];
            const dots = panel.querySelector(".tv-dots");
            const mediaToggle = panel.querySelector(".tv-media-toggle");
            const firstClone = originalSlides[0].cloneNode(true);
            const lastClone = originalSlides[originalSlides.length - 1].cloneNode(true);
            firstClone.setAttribute("aria-hidden", "true");
            lastClone.setAttribute("aria-hidden", "true");
            track.prepend(lastClone);
            track.append(firstClone);

            tvPanelState.set(panel, {
              track,
              originalSlides,
              count: originalSlides.length,
              trackIndex: 1,
              animating: false,
            });
            dots.innerHTML = "";

            [...track.children].forEach((slide) => {
              slide.style.flex = "0 0 100%";
              slide.style.minWidth = "100%";
            });

            originalSlides.forEach((slide, index) => {

              const dot = document.createElement("button");
              dot.type = "button";
              dot.className = `tv-dot${index === 0 ? " active" : ""}`;
              dot.setAttribute("aria-label", `Go to image ${index + 1}`);
              dot.addEventListener("click", () => {
                pauseVideosInPanel(panel);
                const state = tvPanelState.get(panel);
                state.trackIndex = index + 1;
                state.animating = false;
                renderPanelInline(panel);
                restartAutoplayInline();
              });
              dots.appendChild(dot);
            });

            panel.querySelector(".tv-prev").addEventListener("click", () => {
              changeSlideInline(panel, -1);
              restartAutoplayInline();
            });

            panel.querySelector(".tv-next").addEventListener("click", () => {
              changeSlideInline(panel, 1);
              restartAutoplayInline();
            });

            mediaToggle.addEventListener("click", () => {
              const state = tvPanelState.get(panel);
              const video = state?.originalSlides[getLogicalIndex(panel)]?.querySelector("video");
              if (!video) return;

              if (video.paused) {
                pauseAllVideos();
                window.clearInterval(tvTimerInline);
                video.muted = false;
                video.defaultMuted = false;
                video.volume = 1;
                panel.querySelectorAll("video").forEach((item) => {
                  item.muted = false;
                  item.defaultMuted = false;
                  item.volume = 1;
                });
                video.play().catch(() => {});
              } else {
                video.pause();
              }
              updateMediaToggleInline(panel);
            });

            panel.querySelectorAll("video").forEach((video) => {
              video.muted = false;
              video.defaultMuted = false;
              video.volume = 1;

              video.addEventListener("play", () => {
                video.muted = false;
                video.defaultMuted = false;
                video.volume = 1;
                window.clearInterval(tvTimerInline);
                updateMediaToggleInline(panel);
              });
              video.addEventListener("pause", () => {
                updateMediaToggleInline(panel);
                if (panel.classList.contains("active")) {
                  restartAutoplayInline();
                }
              });
              video.addEventListener("ended", () => {
                updateMediaToggleInline(panel);
                if (panel.classList.contains("active")) {
                  restartAutoplayInline();
                }
              });
            });

            track.addEventListener("transitionend", (event) => {
              if (event.propertyName !== "transform") return;
              const state = tvPanelState.get(panel);
              if (!state) return;

              if (state.trackIndex === 0) {
                state.trackIndex = state.count;
                renderPanelInline(panel, false);
              } else if (state.trackIndex === state.count + 1) {
                state.trackIndex = 1;
                renderPanelInline(panel, false);
              }

              state.animating = false;
              updateMediaToggleInline(panel);
            });

            renderPanelInline(panel, false);
          });

          const showTvPanelInline = (panelId) => {
            tvTabsInline.forEach((tab) => {
              const isActive = tab.dataset.tv === panelId;
              tab.classList.toggle("active", isActive);
              tab.setAttribute("aria-selected", String(isActive));
            });

            tvPanelsInline.forEach((panel) => {
              const isActive = panel.id === panelId;
              panel.classList.toggle("active", isActive);
              panel.setAttribute("aria-hidden", String(!isActive));
              panel.style.display = isActive ? "block" : "none";
              panel.style.opacity = isActive ? "1" : "0";
              panel.style.visibility = isActive ? "visible" : "hidden";
              panel.style.pointerEvents = isActive ? "auto" : "none";
              if (!isActive) {
                pauseVideosInPanel(panel);
              } else {
                renderPanelInline(panel);
              }
            });

            restartAutoplayInline();
          };

          tvConsoleInline
            .querySelector(".tv-index")
            .addEventListener("click", (event) => {
              const tab = event.target.closest("button[data-tv]");
              if (!tab) return;
              showTvPanelInline(tab.dataset.tv);
              restartAutoplayInline();
            });

          showTvPanelInline(
            tvTabsInline.find((tab) => tab.classList.contains("active"))?.dataset.tv ||
              "brand",
          );
          tvConsoleInline.addEventListener("mouseenter", () => window.clearInterval(tvTimerInline));
          tvConsoleInline.addEventListener("mouseleave", restartAutoplayInline);
          restartAutoplayInline();
        })();
      </script>
