<!-- =========================================================
     KRIGNAL LAUNCH EVENT VIDEO SECTION — JAVASCRIPT
========================================================== -->

<script>
  (() => {
    const video = document.getElementById("krLaunchVideo");
    const frame = video?.closest(".kr-launch-video-frame");
    const centrePlay = document.getElementById("krLaunchCentrePlay");
    const playButton = document.getElementById("krLaunchPlay");
    const progress = document.getElementById("krLaunchProgress");
    const currentTime = document.getElementById("krLaunchCurrentTime");
    const duration = document.getElementById("krLaunchDuration");
    const muteButton = document.getElementById("krLaunchMute");
    const fullscreenButton = document.getElementById("krLaunchFullscreen");

    if (
      !video ||
      !frame ||
      !centrePlay ||
      !playButton ||
      !progress
    ) {
      return;
    }

    const formatTime = (seconds) => {
      if (!Number.isFinite(seconds)) {
        return "00:00";
      }

      const minutes = Math.floor(seconds / 60);
      const remainingSeconds = Math.floor(seconds % 60);

      return (
        String(minutes).padStart(2, "0") +
        ":" +
        String(remainingSeconds).padStart(2, "0")
      );
    };

    const updatePlayState = () => {
      const isPlaying = !video.paused && !video.ended;

      frame.classList.toggle("is-playing", isPlaying);
      playButton.classList.toggle("is-playing", isPlaying);

      playButton.setAttribute(
        "aria-label",
        isPlaying ? "Pause video" : "Play video"
      );
    };

    const togglePlayback = () => {
      if (video.paused || video.ended) {
        video.play().catch(() => {});
      } else {
        video.pause();
      }
    };

    const updateProgress = () => {
      const progressValue =
        video.duration > 0
          ? (video.currentTime / video.duration) * 100
          : 0;

      progress.value = progressValue;

      progress.style.setProperty(
        "--kr-video-progress",
        progressValue + "%"
      );

      currentTime.textContent = formatTime(video.currentTime);
    };

    centrePlay.addEventListener("click", togglePlayback);
    playButton.addEventListener("click", togglePlayback);

    video.addEventListener("play", updatePlayState);
    video.addEventListener("pause", updatePlayState);
    video.addEventListener("ended", updatePlayState);

    video.addEventListener("loadedmetadata", () => {
      duration.textContent = formatTime(video.duration);
      updateProgress();
    });

    video.addEventListener("timeupdate", updateProgress);

    progress.addEventListener("input", () => {
      if (!video.duration) {
        return;
      }

      video.currentTime =
        (Number(progress.value) / 100) * video.duration;

      updateProgress();
    });

    muteButton.addEventListener("click", () => {
      video.muted = !video.muted;

      muteButton.classList.toggle(
        "is-muted",
        video.muted
      );

      muteButton.setAttribute(
        "aria-label",
        video.muted ? "Unmute video" : "Mute video"
      );
    });

    fullscreenButton.addEventListener("click", () => {
      if (document.fullscreenElement) {
        document.exitFullscreen?.();
        return;
      }

      frame.requestFullscreen?.();
    });

    video.addEventListener("click", togglePlayback);

    updatePlayState();
    updateProgress();
  })();
</script>

