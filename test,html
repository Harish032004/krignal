    <script>
      (() => {
        const section = document.querySelector(".hero-stack");
        const sticky = document.querySelector(".hero-sticky");
        const cards = [...document.querySelectorAll(".hero-gallery .hero-card")];
        const stages = {
          brand: document.querySelector('[data-stage="brand"]'),
          tv: document.querySelector('[data-stage="tv"]'),
          offline: document.querySelector('[data-stage="offline"]'),
          ai: document.querySelector('[data-stage="ai"]'),
        };
        const progressBar = document.getElementById("heroProgressBar");
        const scrollNote = document.getElementById("heroScrollNote");

        if (!section || !sticky || !cards.length) return;

        const clamp = (value, min = 0, max = 1) => Math.min(max, Math.max(min, value));
        const ease = (value) => {
          const t = clamp(value);
          return 1 - Math.pow(1 - t, 3);
        };
        const range = (value, start, end) => clamp((value - start) / (end - start));
        const mix = (from, to, progress) => from + (to - from) * progress;

        const sceneOpacity = (progress, start, inEnd, outStart, outEnd) => {
          const enter = ease(range(progress, start, inEnd));
          const leave = 1 - ease(range(progress, outStart, outEnd));
          return clamp(Math.min(enter, leave));
        };

        const paintStage = (element, opacity) => {
          if (!element) return;
          element.style.opacity = opacity.toFixed(4);
          element.style.visibility = opacity > 0.02 ? "visible" : "hidden";
          element.style.transform = `translate3d(-50%, ${((1 - opacity) * 18).toFixed(2)}px, 0)`;
        };

        const getProgress = () => {
          const stickyTop = parseFloat(getComputedStyle(sticky).top) || 0;
          const sectionTop = window.scrollY + section.getBoundingClientRect().top;
          const travel = Math.max(1, section.offsetHeight - sticky.offsetHeight);
          return clamp((window.scrollY - (sectionTop - stickyTop)) / travel);
        };

        const paintCards = (progress) => {
          const mobile = window.innerWidth <= 760;
          const vh = sticky.clientHeight;
          const visibleCount = mobile ? Math.min(cards.length, 10) : cards.length;
          const half = (visibleCount - 1) / 2;
          const cycle = progress * (mobile ? visibleCount * 1.05 : visibleCount * 1.35);
          const stepX = mobile ? 18.5 : 12.2;
          const baseY = mobile ? vh * 0.56 : vh * 0.53;
          const curve = mobile ? 24 : 30;
          const featuredScale = mobile ? 1.22 : 1.56;
          const edgeScale = mobile ? 0.8 : 0.84;

          const wrapRelative = (value, total) => {
            const wrapped = ((value % total) + total) % total;
            return wrapped > total / 2 ? wrapped - total : wrapped;
          };

          cards.forEach((card, index) => {
            if (index >= visibleCount) {
              card.style.opacity = "0";
              card.style.visibility = "hidden";
              card.classList.remove("is-featured");
              return;
            }

            const rel = wrapRelative(index - cycle, visibleCount);
            const distance = Math.abs(rel);
            const side = clamp(distance / Math.max(half, 1));
            const featured = distance < 0.42;
            const x = rel * stepX;
            const y = baseY - vh * 0.22 + Math.pow(distance, 1.58) * curve;
            const rotate = rel * (mobile ? 7.5 : 5.6);
            const scale = featured
              ? featuredScale - distance * 0.22
              : mix(featuredScale, edgeScale, side);
            const opacity = mix(1, mobile ? 0.52 : 0.38, side);
            const zIndex = Math.round(220 - distance * 18);

            card.classList.toggle("is-featured", featured);

            card.style.visibility = "visible";
            card.style.opacity = opacity.toFixed(4);
            card.style.zIndex = String(zIndex);
            card.style.filter = "none";
            card.style.transform = `translate3d(calc(-50% + ${x.toFixed(2)}vw), ${y.toFixed(2)}px, 0) rotate(${rotate.toFixed(2)}deg) scale(${scale.toFixed(4)})`;
          });
        };

        let ticking = false;
        const update = () => {
          ticking = false;
          const progress = getProgress();

          paintCards(progress);
          paintStage(stages.brand, sceneOpacity(progress, 0.08, 0.16, 0.26, 0.34));
          paintStage(stages.tv, sceneOpacity(progress, 0.31, 0.39, 0.49, 0.57));
          paintStage(stages.offline, sceneOpacity(progress, 0.54, 0.62, 0.72, 0.8));
          paintStage(stages.ai, clamp(ease(range(progress, 0.77, 0.88))));

          if (progressBar) {
            progressBar.style.width = `${(progress * 100).toFixed(2)}%`;
          }

          if (scrollNote) {
            scrollNote.style.opacity = String(clamp(1 - progress * 2.1));
          }
        };

        const requestPaint = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(update);
        };

        window.addEventListener("scroll", requestPaint, { passive: true });
        window.addEventListener("resize", requestPaint, { passive: true });
        requestPaint();
      })();
    </script>
