    let activeIndex = cardsPerView;
    let isAnimating = false;
    let autoplayTimer = null;

    const buildTrack = () => {
      cardsPerView = Math.min(getCardsPerView(), originalCards.length);
      track.innerHTML = "";

      const leadingClones = originalCards
        .slice(-cardsPerView)
        .map((card) => card.cloneNode(true));
      const trailingClones = originalCards
        .slice(0, cardsPerView)
        .map((card) => card.cloneNode(true));

      [...leadingClones, ...originalCards.map((card) => card.cloneNode(true)), ...trailingClones]
        .forEach((card, index) => {
          const isClone =
            index < cardsPerView || index >= cardsPerView + originalCards.length;
