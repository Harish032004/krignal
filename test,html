  /* =========================================================
     LEFT BLACK INFORMATION BOX
  ========================================================== */

  .hero-final {
    position: absolute;

    left: 2.2vw;
    top: 5%;

    z-index: 40;

    width: min(47vw, 900px);
    height: 80%;

    overflow: visible;

    border: 1px solid rgba(237, 199, 90, 0.32);
    border-radius: clamp(20px, 2vw, 34px);

    background:
      radial-gradient(
        circle at 8% 4%,
        rgba(237, 199, 90, 0.13),
        transparent 31%
      ),
      linear-gradient(
        145deg,
        #141311,
        #080808 72%
      );

    box-shadow:
      0 30px 90px rgba(0, 0, 0, 0.23),
      inset 0 1px rgba(255, 255, 255, 0.04);

    opacity: 0;

    clip-path:
      inset(
        0 100% 0 0
        round 28px
      );

    transform: translateX(-45px);

    will-change:
      opacity,
      clip-path,
      transform;
  }

  .hero-final::before {
    content: "K";

    position: absolute;

    right: -18px;
    bottom: -70px;

    color: rgba(237, 199, 90, 0.045);

    font:
      400 clamp(230px, 24vw, 410px) / 1
      var(--serif, Georgia, serif);

    pointer-events: none;
  }

  .hero-final::after {
    content: "";

    position: absolute;

    left: 32px;
    right: 32px;
    top: 30px;

    height: 1px;

    background:
      linear-gradient(
        90deg,
        #edc75a,
        rgba(237, 199, 90, 0)
      );

    pointer-events: none;
  }

  .hero-final-content {
    position: relative;
    z-index: 3;

    width: 100%;
    height: 100%;

    display: flex;
    flex-direction: column;
    justify-content: flex-start;

    padding:
      clamp(34px, 3.7vh, 46px)
      clamp(22px, 2vw, 30px)
      clamp(20px, 2.2vh, 28px);

    overflow: hidden;

    border-radius: inherit;
  }


  /* =========================================================
     YELLOW VERIFIED BADGE
  ========================================================== */

  .hero-badge {
    position: absolute;

    top: clamp(16px, 1.8vw, 28px);
    right: clamp(16px, 1.8vw, 28px);

    z-index: 15;

    width: clamp(88px, 7.5vw, 118px);
    height: clamp(88px, 7.5vw, 118px);

    filter:
      drop-shadow(
        0 15px 28px rgba(0, 0, 0, 0.3)
      );

    transform: rotate(5deg);

    transition:
      transform 0.4s ease,
      filter 0.4s ease;
  }

  .hero-badge:hover {
    transform: rotate(0deg) scale(1.045);

    filter:
      drop-shadow(
        0 20px 34px rgba(237, 199, 90, 0.25)
      );
  }

  .hero-badge svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero-badge-background {
    fill: #edc75a;
  }

  .hero-badge-dashed {
    fill: none;
    stroke: #12110e;
    stroke-width: 1.5;
    stroke-dasharray: 4 5;
  }

  .hero-badge-circle-text {
    fill: #12110e;

    font-family:
      "IBM Plex Mono",
      monospace;

    font-size: 8.5px;
    font-weight: 500;

    letter-spacing: 1.7px;
  }

  .hero-badge-letter {
    fill: #12110e;

    font-family:
      "Libre Caslon Display",
      Georgia,
      serif;

    font-size: 38px;
    font-weight: 400;
