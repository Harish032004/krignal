    nextButton.addEventListener("click", () => {
      move(1);
      startAutoplay();
    });

    track.addEventListener("transitionend", (event) => {
      if (event.propertyName !== "transform") return;

      if (activeIndex >= originalCards.length + cardsPerView) {
        activeIndex = cardsPerView;
        renderTrack(false);
      } else if (activeIndex < cardsPerView) {
        activeIndex = originalCards.length + cardsPerView - 1;
        renderTrack(false);
      }

      isAnimating = false;
    });

    carousel.addEventListener("mouseenter", stopAutoplay);
    carousel.addEventListener("mouseleave", startAutoplay);
    carousel.addEventListener("focusin", stopAutoplay);
    carousel.addEventListener("focusout", startAutoplay);
    window.addEventListener("resize", () => {
      buildTrack();
      startAutoplay();
    });

    buildTrack();
    startAutoplay();
  })();
</script>
<script>
  (() => {
    const pastCarouselCards = [
      ...document.querySelectorAll("#past .past-carousel-card"),
    ];

    if (!pastCarouselCards.length) return;

    pastCarouselCards.forEach((card) => {
      const track = card.querySelector(".past-event-track");
      const dotsContainer = card.querySelector(".past-event-dots");
      const previousButton = card.querySelector(".past-carousel-prev");
      const nextButton = card.querySelector(".past-carousel-next");

      if (!track || !dotsContainer || !previousButton || !nextButton) {
        return;
      }

      const originalSlides = [...track.querySelectorAll(".past-event-slide")];
      if (originalSlides.length < 2) return;

      const slideCount = originalSlides.length;
      const firstClone = originalSlides[0].cloneNode(true);
      const lastClone = originalSlides[originalSlides.length - 1].cloneNode(true);

      firstClone.setAttribute("aria-hidden", "true");
      lastClone.setAttribute("aria-hidden", "true");

      track.prepend(lastClone);
      track.append(firstClone);

      let trackIndex = 1;
      let isAnimating = false;
      let autoplayTimer = null;

      const getLogicalIndex = () => ((trackIndex - 1 + slideCount) % slideCount);

      const updateDots = () => {
        const logicalIndex = getLogicalIndex();
        dotsContainer.querySelectorAll(".past-event-dot").forEach((dot, dotIndex) => {
          dot.classList.toggle("active", dotIndex === logicalIndex);
        });
      };

      const pauseCardVideos = () => {
        track.querySelectorAll("video").forEach((video) => video.pause());
      };

      const isActiveVideoPlaying = () => {
        const activeSlide = track.children[trackIndex];
        const video = activeSlide?.querySelector("video");
        return Boolean(video && !video.paused && !video.ended);
      };

      const playActiveVideo = () => {
        const activeSlide = track.children[trackIndex];
        const video = activeSlide?.querySelector("video");
        if (!video) return;
        video.currentTime = 0;
        video.play().catch(() => {});
      };

      const renderTrack = (animate = true) => {
        if (!animate) {
          track.classList.add("no-transition");
        }

        track.style.transform = `translate3d(-${trackIndex * 100}%, 0, 0)`;
        updateDots();

        if (!animate) {
          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              track.classList.remove("no-transition");
            });
          });
        }
      };

      const moveCarousel = (direction) => {
        if (isAnimating) return;

        pauseCardVideos();
        isAnimating = true;

        if (direction > 0) {
          trackIndex += 1;
        } else {
          const logicalIndex = getLogicalIndex();
          trackIndex += logicalIndex === 0 ? slideCount - 1 : -1;
        }

        renderTrack(true);
      };

      const stopAutoplay = () => {
        window.clearInterval(autoplayTimer);
      };

      const startAutoplay = () => {
        stopAutoplay();
        autoplayTimer = window.setInterval(() => {
          const pastPanel = document.getElementById("past");
          if (!pastPanel?.classList.contains("active")) return;
          if (isActiveVideoPlaying()) return;
          moveCarousel(1);
        }, 2800);
      };

      dotsContainer.innerHTML = "";
      originalSlides.forEach((_, dotIndex) => {
        const dot = document.createElement("button");
        dot.type = "button";
        dot.className = "past-event-dot" + (dotIndex === 0 ? " active" : "");
        dot.setAttribute("aria-label", `Go to image ${dotIndex + 1}`);
        dot.addEventListener("click", () => {
          pauseCardVideos();
          trackIndex = dotIndex + 1;
          isAnimating = false;
          renderTrack(true);
          playActiveVideo();
          startAutoplay();
        });
        dotsContainer.appendChild(dot);
      });

      previousButton.addEventListener("click", () => {
        moveCarousel(-1);
        startAutoplay();
      });

      nextButton.addEventListener("click", () => {
        moveCarousel(1);
        startAutoplay();
      });

      track.addEventListener("transitionend", (event) => {
        if (event.propertyName !== "transform") return;

        if (trackIndex >= slideCount + 1) {
          trackIndex = 1;
          renderTrack(false);
        }

        isAnimating = false;
        playActiveVideo();
      });

      card.addEventListener("mouseenter", stopAutoplay);
      card.addEventListener("mouseleave", startAutoplay);
      card.addEventListener("focusin", stopAutoplay);
      card.addEventListener("focusout", startAutoplay);

      track.querySelectorAll("video").forEach((video) => {
        video.addEventListener("play", stopAutoplay);
        video.addEventListener("pause", startAutoplay);
        video.addEventListener("ended", startAutoplay);
      });

      renderTrack(false);
      playActiveVideo();
      startAutoplay();
    });
  })();
</script>
